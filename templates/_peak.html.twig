{# @var peak \Jmonitor\EasyAdminBundle\Metric\Peak #}
<div class="jm-peak">
    <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
        <rect class="jm-peak-track" x="0" y="2" width="100" height="6" rx="1"/>
        <rect class="jm-peak-value" x="0" y="2" width="{{ peak.currentPercent|round(2) }}" height="6" rx="1"/>
        <rect class="jm-peak-marker" x="{{ max(0, peak.peakPercent - 0.5)|round(2) }}" y="0" width="1" height="10"/>
    </svg>
    <div class="d-flex justify-content-between small text-muted mt-1">
        <span>Current: {{ currentLabel }} · Peak: {{ peakLabel }}</span>
        <span>{{ maxLabel }}</span>
    </div>
</div>
