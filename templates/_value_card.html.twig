{% embed '@JmonitorEasyAdmin/_card.html.twig' %}
    {% block body %}
        <div class="jm-stat">
            {%- if rate|default(null) -%}
                {{ include('@JmonitorEasyAdmin/_rate.html.twig', {rate: rate, format: format|default('number')}) }}
            {%- else -%}
                {{ include('@JmonitorEasyAdmin/_value.html.twig', {value: value|default(null)}) }}
            {%- endif -%}
        </div>
    {% endblock %}
{% endembed %}
