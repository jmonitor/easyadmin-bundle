{%- if value is null or value is same as('') -%}
    <span class="text-muted">—</span>
{%- elseif value is same as(true) -%}
    <twig:ea:Badge variant="success">On</twig:ea:Badge>
{%- elseif value is same as(false) -%}
    <twig:ea:Badge variant="secondary">Off</twig:ea:Badge>
{%- elseif value.style is defined -%}
    {{ include('@JmonitorEasyAdmin/_badge.html.twig', {badge: value}) }}
{%- else -%}
    {{ value }}
{%- endif -%}
