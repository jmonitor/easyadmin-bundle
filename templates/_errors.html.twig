{% if snapshot.error %}
    {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'warning', class: 'mb-3', message: snapshot.error}) }}
{% endif %}
{% if snapshot.inProgress %}
    {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'info', class: 'py-2 small mb-3', message: constant('Jmonitor\\EasyAdminBundle\\Snapshot\\SnapshotProvider::IN_PROGRESS')}) }}
{% endif %}
{% for error in snapshot.errors %}
    {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'warning', class: 'py-2 small mb-3', message: error}) }}
{% endfor %}
