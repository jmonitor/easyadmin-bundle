{% if snapshot.error %}
    <div class="alert alert-warning mb-3">{{ snapshot.error }}</div>
{% endif %}
{% if snapshot.inProgress %}
    <div class="alert alert-info py-2 small mb-3">{{ constant('Jmonitor\\EasyAdminBundle\\Snapshot\\SnapshotProvider::IN_PROGRESS') }}</div>
{% endif %}
{% for error in snapshot.errors %}
    <div class="alert alert-warning py-2 small mb-3">{{ error }}</div>
{% endfor %}
