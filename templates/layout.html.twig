{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Monitoring{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/jmonitoreasyadmin/monitoring.css') }}">
{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    {% set scripts = ['help.js', 'navigation.js']|merge(current and polling_interval > 0 ? ['live.js'] : []) %}
    {% for script in scripts %}
        {% guard function csp_nonce %}
            <script src="{{ asset('bundles/jmonitoreasyadmin/' ~ script) }}" nonce="{{ csp_nonce('script') }}" defer></script>
        {% else %}
            <script src="{{ asset('bundles/jmonitoreasyadmin/' ~ script) }}" defer></script>
        {% endguard %}
    {% endfor %}
{% endblock %}

{% block main %}
    <div class="jm-monitoring"
        {% if current and polling_interval > 0 %}
            data-live
            data-live-url="{{ path(routes.fragment, {component: current.value, connection: instance.id}) }}"
            data-live-index-url="{{ path(routes.index) }}"
            data-live-interval="{{ polling_interval }}"
        {% endif %}
    >
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <ul class="nav nav-tabs flex-grow-1">
                {% for component in components %}
                    <li class="nav-item">
                        <a class="nav-link{{ component is same as(current) ? ' active' }}"{% if component is same as(current) %} aria-current="page"{% endif %} href="{{ path(routes.component, {component: component.value}) }}">{{ component.label }}</a>
                    </li>
                {% endfor %}
            </ul>
            {% if current %}
                <div class="d-flex align-items-center gap-3">
                    {% if polling_interval > 0 %}
                        <div class="jm-live">
                            <label class="jm-live-switch" for="jm-live-toggle">
                                <twig:ea:Switch id="jm-live-toggle" checked data-live-toggle />
                                Live <span class="text-muted">· every {{ polling_interval }} s</span>
                            </label>
                            <div class="small text-muted" data-live-status>Last update: <span class="jm-live-ago"><time data-live-updated>just now</time><span class="jm-live-ago-widest" aria-hidden="true">59 min ago</span></span><span data-live-failed hidden> · refresh failed</span></div>
                        </div>
                    {% endif %}
                    <form method="post" action="{{ path(routes.refresh, {component: current.value, connection: instance.id}) }}">
                        {% guard function csrf_token %}
                            <input type="hidden" name="_token" value="{{ csrf_token('jmonitor_refresh') }}">
                        {% endguard %}
                        <button type="submit" class="btn btn-secondary btn-sm" title="Collect the metrics again now">Refresh</button>
                    </form>
                </div>
            {% endif %}
        </div>

        {% if navigation.pills %}
            <ul class="nav nav-pills jm-instances mb-3">
                {% for item in navigation.pills %}
                    <li class="nav-item">
                        <a class="nav-link py-1 px-2{{ item.active ? ' active' }}"{% if item.active %} aria-current="true"{% endif %} href="{{ path(routes.component, {component: current.value, connection: item.target.id}) }}">
                            {{ item.label }}{% if item.detail %} <span class="small opacity-75">· {{ item.detail }}</span>{% endif %}{% if item.error %} <span class="jm-instance-error" role="img" title="{{ item.error }}" aria-label="Detection failed"></span>{% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div data-live-content>
            {% block jm_content %}{% endblock %}
        </div>
    </div>

    <div class="offcanvas offcanvas-end jm-help-panel" tabindex="-1" id="jm-help-panel" aria-labelledby="jm-help-panel-title" data-jm-help-panel>
        <div class="offcanvas-header gap-2">
            <h5 class="offcanvas-title me-auto" id="jm-help-panel-title">Help</h5>
            <a class="small" href="#" target="_blank" rel="noopener noreferrer" data-jm-help-external>Open in a new tab</a>
            <button type="button" class="btn-close ms-0" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0 overflow-hidden">
            <template data-jm-help-frame>
                <iframe class="jm-help-frame" title="Help" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>
            </template>
        </div>
    </div>
{% endblock %}
