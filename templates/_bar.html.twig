{# percent: 0 to 100; style: a BadgeStyle or null #}
<svg class="jm-bar{{ style|default(null) ? ' jm-bar-' ~ style.value }}" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
    <rect class="jm-bar-track" x="0" y="0" width="100" height="6" rx="1"/>
    <rect class="jm-bar-value" x="0" y="0" width="{{ max(0, min(100, percent))|round(2) }}" height="6" rx="1"/>
</svg>
