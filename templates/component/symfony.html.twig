{% extends fragment ? '@JmonitorEasyAdmin/fragment.html.twig' : '@JmonitorEasyAdmin/layout.html.twig' %}

{% block jm_content %}
    {{ include('@JmonitorEasyAdmin/_errors.html.twig') }}

    <div class="row g-3">
        <div class="col-md-4 col-xl-3">
            <div class="d-flex flex-column gap-3 h-100">
                <div class="flex-fill">{{ include('@JmonitorEasyAdmin/_value_card.html.twig', {title: 'Symfony version', metric: 'symfony.version', value: view.version, badge: view.versionStatus}) }}</div>
                <div class="flex-fill">{{ include('@JmonitorEasyAdmin/_value_card.html.twig', {title: 'Environment', metric: 'symfony.environment', value: view.environment, badge: view.debug}) }}</div>
            </div>
        </div>
        <div class="col-md-8 col-xl-5">
            <div class="card h-100">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#jm-symfony-recommendations" aria-controls="jm-symfony-recommendations" aria-selected="true">Recommendations</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" type="button" role="tab" data-bs-toggle="tab" data-bs-target="#jm-symfony-bundles" aria-controls="jm-symfony-bundles" aria-selected="false">Bundles <twig:ea:Badge variant="secondary">{{ view.bundles|length }}</twig:ea:Badge></button>
                        </li>
                    </ul>
                </div>
                <div class="card-body jm-scroll tab-content">
                    <div class="tab-pane active" id="jm-symfony-recommendations" role="tabpanel">
                        {% if view.recommendationsAvailable %}
                            {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                                'OPcache': view.opcache,
                                'APCu': view.apcu,
                            }}) }}
                            <hr>
                            <h6 class="text-muted">[PHP]</h6>
                            <dl class="jm-kv mb-0">
                                <div class="jm-kv-row">
                                    <dt>realpath_cache_size</dt>
                                    <dd>
                                        {%- if view.realpathCacheSizeStyle -%}
                                            <twig:ea:Badge :variant="view.realpathCacheSizeStyle.value">{{ view.realpathCacheSize|jm_bytes }}</twig:ea:Badge>
                                        {%- else -%}
                                            {{ include('@JmonitorEasyAdmin/_value.html.twig', {value: null}) }}
                                        {%- endif -%}
                                    </dd>
                                </div>
                            </dl>
                            {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {'realpath_cache_ttl': view.realpathCacheTtl}}) }}
                        {% else %}
                            <p class="text-muted mb-0">The PHP metrics are not available.</p>
                        {% endif %}
                    </div>
                    <div class="tab-pane" id="jm-symfony-bundles" role="tabpanel">
                        {{ view.bundles|join(', ') }}
                    </div>
                </div>
            </div>
        </div>
        {% if view.flexEnabled %}
            <div class="col-xl-4">
                {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Flex recipes', metric: 'symfony.flex', badge: view.flex} %}
                    {% block body %}
                        {% if view.flexError %}
                            {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'warning', class: 'py-2 small mb-2 text-break', message: view.flexError}) }}
                            <p class="small text-muted mb-0">The check runs <code>composer recipes -o</code> in the project directory, as the user running PHP, and stops after 5 seconds: <code>composer</code> must be in the <code>PATH</code> of that user and reach the Symfony recipes server. Click Refresh once fixed, or set <code>flex: false</code> under <code>jmonitor_easyadmin.components.symfony</code> to hide this card.</p>
                        {% elseif not view.flexAvailable %}
                            <p class="text-muted mb-0">Flex recipes are not collected.</p>
                        {% elseif view.flexCheckFailed %}
                            <p class="text-muted mb-0">The recipes check could not run: is <code>composer</code> available on this server?</p>
                        {% elseif view.recipesUpToDate %}
                            <p class="mb-0">Configuration optimized.<br><span class="text-muted">No recipe updates required.</span></p>
                        {% else %}
                            <ul class="mb-0">
                                {% for recipe in view.outdatedRecipes %}
                                    <li>{{ recipe }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            </div>
        {% endif %}
    </div>

    {% if view.messengerEnabled or view.schedulerEnabled %}
        <h2 class="h5 mt-4 mb-2">Components</h2>
        <div class="row g-3">
            {% if view.messengerEnabled %}
                <div class="col-md-6 col-xxl-4">
                    {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Messenger', metric: 'symfony.messenger'} %}
                        {% block body %}
                            {% if view.messengerError %}
                                {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'warning', class: 'py-2 small mb-2 text-break', message: view.messengerError}) }}
                                <p class="small text-muted mb-0">The stats come from <code>bin/console messenger:stats --format=json</code> (Symfony 7.2 or later), run in a PHP CLI process from the project directory and stopped after 3 seconds. Click Refresh once fixed, or set <code>messenger: false</code> under <code>jmonitor_easyadmin.components.symfony</code> to hide this card.</p>
                            {% elseif not view.messengerAvailable %}
                                <p class="text-muted mb-0">Messenger stats are not collected.</p>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead><tr><th>Transport</th><th class="text-end">Messages</th></tr></thead>
                                        <tbody>
                                            {% for name, count in view.messengerTransports %}
                                                <tr>
                                                    <td>{{ name }}</td>
                                                    <td class="text-end">{{ include('@JmonitorEasyAdmin/_value.html.twig', {value: count}) }}</td>
                                                </tr>
                                            {% endfor %}
                                            {% for name in view.messengerUncountable %}
                                                <tr>
                                                    <td>{{ name }}</td>
                                                    <td class="text-end text-muted">Uncountable</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}
            {% if view.schedulerEnabled %}
                <div class="col-md-6 col-xxl-5">
                    {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Scheduler - Next task', metric: 'symfony.scheduler_next_task'} %}
                        {% block body %}
                            {% if view.schedulerError %}
                                {{ include('@JmonitorEasyAdmin/_alert.html.twig', {variant: 'warning', class: 'py-2 small mb-2 text-break', message: view.schedulerError}) }}
                                <p class="small text-muted mb-0">The tasks come from the <code>debug:scheduler</code> command, run in the web process. Click Refresh once fixed, or set <code>scheduler: false</code> under <code>jmonitor_easyadmin.components.symfony</code> to hide this card.</p>
                            {% elseif not view.nextTask %}
                                <p class="text-muted mb-0">No tasks</p>
                            {% else %}
                                <div class="d-flex flex-wrap align-items-start column-gap-3 row-gap-2">
                                    <div class="jm-next-task-main">
                                        <div class="fs-5"><code>{{ view.nextTask.command }}</code></div>
                                        {% if view.nextTask.description %}<div class="text-muted">{{ view.nextTask.description }}</div>{% endif %}
                                        <div class="mt-2">
                                            {% if view.nextTask.trigger %}<twig:ea:Badge variant="info">{{ view.nextTask.trigger }}</twig:ea:Badge>{% endif %}
                                            {% if view.nextTask.jitter %}<span class="small text-muted ms-1">{{ view.nextTask.jitter }} jitters</span>{% endif %}
                                        </div>
                                    </div>
                                    {% if view.nextTask.next_run %}
                                        <div class="ms-auto text-end">
                                            <div class="fs-5">{{ view.nextTask.next_run|jm_ago }}</div>
                                            <div class="small text-muted">{{ view.nextTask.next_run|date('Y-m-d H:i:s') }}</div>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if view.schedulerTasks is not empty %}
        <div class="card mt-3">
            <div class="card-header d-flex align-items-center gap-2">
                <span>Scheduler - Upcoming tasks</span>
                {{ include('@JmonitorEasyAdmin/_help.html.twig', {metric: 'symfony.scheduler_tasks', label: 'Scheduler - Upcoming tasks'}) }}
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Command</th><th>Description</th><th>Trigger</th><th>Next run</th></tr></thead>
                        <tbody>
                            {% for task in view.schedulerTasks %}
                                <tr>
                                    <td><code>{{ task.command }}</code></td>
                                    <td class="jm-text-cell">{{ task.description }}</td>
                                    <td class="text-nowrap">
                                        {{ task.trigger ? task.trigger|capitalize : "—" }}
                                        {% if task.jitter %}<div class="small text-muted">{{ task.jitter }} jitters</div>{% endif %}
                                    </td>
                                    <td class="text-nowrap">
                                        {% if task.next_run %}
                                            {{ task.next_run|jm_ago }}
                                            <div class="small text-muted">{{ task.next_run|date('Y-m-d H:i:s') }}</div>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
