{% extends fragment ? '@JmonitorEasyAdmin/fragment.html.twig' : '@JmonitorEasyAdmin/layout.html.twig' %}

{% block jm_content %}
    {{ include('@JmonitorEasyAdmin/_errors.html.twig') }}

    {% if view.debugInProduction %}
        <div class="alert alert-danger">Debug mode is enabled in the production environment.</div>
    {% endif %}

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">Application {{ include('@JmonitorEasyAdmin/_help.html.twig', {metric: 'symfony.version'}) }}</div>
                <div class="card-body">
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                        'Symfony version': view.version,
                        'Environment': view.environment,
                        'Debug': view.debug,
                        'Charset': view.charset,
                        'Project dir': view.projectDir,
                        'Cache dir': view.cacheDir,
                        'Log dir': view.logDir,
                    }}) }}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">Recommendations</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        {% for recommendation in view.recommendations %}
                            <li class="d-flex justify-content-between align-items-center py-1">
                                <span>{{ recommendation.label }}{% if recommendation.value %} <small class="text-muted">({{ recommendation.value }})</small>{% endif %}</span>
                                {% if recommendation.ok is null %}
                                    <span class="badge text-bg-secondary">unknown</span>
                                {% elseif recommendation.ok %}
                                    <span class="badge text-bg-success">OK</span>
                                {% else %}
                                    <span class="badge text-bg-warning">check</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">Bundles <span class="badge text-bg-secondary">{{ view.bundles|length }}</span></div>
                <div class="card-body d-flex flex-wrap gap-1 align-content-start">
                    {% for bundle in view.bundles %}
                        <span class="badge text-bg-light border">{{ bundle }}</span>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">Messenger {{ include('@JmonitorEasyAdmin/_help.html.twig', {metric: 'symfony.messenger'}) }}</div>
                <div class="card-body">
                    {% if not view.messengerAvailable %}
                        <p class="text-muted mb-0">Messenger stats are not collected.</p>
                    {% else %}
                        <table class="table table-sm mb-2">
                            <thead><tr><th>Transport</th><th class="text-end">Queued</th></tr></thead>
                            <tbody>
                                {% for name, count in view.messengerTransports %}
                                    <tr>
                                        <td>{{ name }}</td>
                                        <td class="text-end">{% if count is null %}—{% else %}<span class="badge {{ count > 0 ? 'text-bg-warning' : 'text-bg-success' }}">{{ count }}</span>{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% if view.messengerUncountable %}
                            <small class="text-muted">Not countable: {{ view.messengerUncountable|join(', ') }}</small>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header">Scheduler {{ include('@JmonitorEasyAdmin/_help.html.twig', {metric: 'symfony.scheduler_tasks'}) }}</div>
                <div class="card-body">
                    {% if not view.schedulerAvailable %}
                        <p class="text-muted mb-0">Scheduler tasks are not collected.</p>
                    {% elseif view.schedulerTasks is empty %}
                        <p class="text-muted mb-0">No scheduled task.</p>
                    {% else %}
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Command</th><th>Trigger</th><th>Next run</th></tr></thead>
                            <tbody>
                                {% for task in view.schedulerTasks %}
                                    <tr>
                                        <td><code>{{ task.command }}</code>{% if task.description %}<br><small class="text-muted">{{ task.description }}</small>{% endif %}</td>
                                        <td>{{ task.trigger }}</td>
                                        <td>{{ task.next_run is null ? '—' : task.next_run|date('Y-m-d H:i:s') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">Flex recipes {{ include('@JmonitorEasyAdmin/_help.html.twig', {metric: 'symfony.flex'}) }}</div>
        <div class="card-body">
            {% if not view.flexAvailable %}
                <p class="text-muted mb-0">Flex recipes are not collected.</p>
            {% elseif view.flexCheckFailed %}
                <p class="text-muted mb-0">The recipes check could not run: is <code>composer</code> available on this server?</p>
            {% elseif view.recipesUpToDate %}
                <span class="badge text-bg-success">All recipes are up to date</span>
            {% else %}
                <span class="badge text-bg-warning">{{ view.outdatedRecipes|length }} outdated</span>
                <span class="ms-2">{{ view.outdatedRecipes|join(', ') }}</span>
            {% endif %}
        </div>
    </div>
{% endblock %}
