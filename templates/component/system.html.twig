{% extends fragment ? '@JmonitorEasyAdmin/fragment.html.twig' : '@JmonitorEasyAdmin/layout.html.twig' %}

{% block jm_content %}
    {{ include('@JmonitorEasyAdmin/_errors.html.twig') }}

    <div class="row g-3">
        <div class="col-md-4 col-xl-3">
            {{ include('@JmonitorEasyAdmin/_gauge.html.twig', {gauge: view.ram, detail: view.ramUsed is null ? null : view.ramUsed|jm_bytes ~ ' / ' ~ view.ramTotal|jm_bytes}) }}
        </div>
        <div class="col-md-4 col-xl-3">
            {{ include('@JmonitorEasyAdmin/_gauge.html.twig', {gauge: view.cpu, detail: view.cores is null ? null : view.cores ~ ' cores'}) }}
        </div>
        <div class="col-md-4 col-xl-3">
            {{ include('@JmonitorEasyAdmin/_gauge.html.twig', {gauge: view.disk, detail: view.diskUsed is null ? null : view.diskUsed|jm_bytes ~ ' / ' ~ view.diskTotal|jm_bytes}) }}
        </div>
        <div class="col-xl-3">
            {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'System informations', metric: 'system.informations'} %}
                {% block body %}
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                        'Hostname': view.hostname,
                        'OS': view.os,
                        'Server time': view.time is null ? null : view.time|date('Y-m-d H:i'),
                        'Timezone': view.timezone,
                        'Uptime': view.uptime|jm_duration,
                    }}) }}
                    {% if view.load1 is not null %}
                        <div class="text-muted mt-3 mb-2">Load average</div>
                        <div class="row g-2 text-center">
                            {% for minutes, load in {1: view.load1, 5: view.load5, 15: view.load15} %}
                                <div class="col-4">
                                    <div class="jm-tile">
                                        <div class="jm-tile-value">{{ load|jm_number(2) }}</div>
                                        <div class="jm-tile-label">{{ minutes }} min</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>
{% endblock %}
