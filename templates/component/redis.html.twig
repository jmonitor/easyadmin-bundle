{% extends fragment ? '@JmonitorEasyAdmin/fragment.html.twig' : '@JmonitorEasyAdmin/layout.html.twig' %}

{% block jm_content %}
    {{ include('@JmonitorEasyAdmin/_errors.html.twig') }}

    <div class="row g-3">
        <div class="col-md-4 col-xl-3">
            <div class="d-flex flex-column gap-3 h-100">
                <div class="flex-fill">{{ include('@JmonitorEasyAdmin/_value_card.html.twig', {title: 'Version', metric: 'redis.version', value: view.version}) }}</div>
                <div class="flex-fill">{{ include('@JmonitorEasyAdmin/_value_card.html.twig', {title: 'Execution mode', metric: 'redis.mode', value: view.mode}) }}</div>
            </div>
        </div>
        <div class="col-md-8 col-xl-5">
            {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Redis informations', metric: 'redis.informations'} %}
                {% block body %}
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                        'Max memory': view.maxMemoryUnlimited ?? (view.maxMemoryBytes is null ? null : view.maxMemoryBytes|jm_bytes),
                        'Max memory policy': view.maxMemoryPolicy,
                        'Port': view.port,
                        'Uptime': view.uptime|jm_duration,
                    }}) }}
                    <hr>
                    <h6 class="text-muted small">Replication</h6>
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                        'Role': view.role,
                        'Connected slaves': view.connectedSlaves,
                    }}) }}
                {% endblock %}
            {% endembed %}
        </div>
        <div class="col-md-6 col-xl-4">
            {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Persistence', metric: 'redis.persistence'} %}
                {% block body %}
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {'RDB': view.rdb}}) }}
                    {% if view.rdbActive %}
                        {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                            'Last save': view.rdbLastSave|jm_ago,
                            'Unsaved changes': view.rdbUnsavedChanges,
                            'Last save status': view.rdbLastSaveStatus,
                        }}) }}
                    {% endif %}
                    <hr>
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {'AOF': view.aof}}) }}
                    {% if view.aofEnabled %}
                        {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                            'Last rewrite status': view.aofLastRewriteStatus,
                            'Last rewrite duration': view.aofLastRewriteDuration|jm_duration,
                            'AOF file size': view.aofFileSize|jm_bytes,
                            'Growth since last rewrite': view.aofGrowth,
                        }}) }}
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    <h2 class="h5 mt-4 mb-2">Memory</h2>
    <div class="row g-3">
        <div class="col-md-6">
            {% if view.memoryUsage %}
                {{ include('@JmonitorEasyAdmin/_gauge.html.twig', {gauge: view.memoryUsage, detail: view.usedMemory ? view.usedMemory|jm_bytes ~ ' / ' ~ view.maxMemoryBytes|jm_bytes : null}) }}
            {% else %}
                {{ block('memory_peak') }}
            {% endif %}
        </div>
        <div class="col-md-6">
            {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Max memory policy', metric: 'redis.max_memory_policy'} %}
                {% block body %}
                    {% if view.maxMemoryPolicy %}
                        <div class="fs-5 mb-2">{{ include('@JmonitorEasyAdmin/_badge.html.twig', {badge: view.maxMemoryPolicy}) }}</div>
                        {% if view.maxMemoryPolicyDescription %}<p class="text-muted mb-0">{{ view.maxMemoryPolicyDescription }}</p>{% endif %}
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
        {% if view.memoryUsage and view.peakMemory is not null %}
            <div class="col-12">{{ block('memory_peak') }}</div>
        {% endif %}
    </div>

    <h2 class="h5 mt-4 mb-2">Performances</h2>
    <div class="row g-3">
        <div class="col-md-6 col-xl-4">
            {{ include('@JmonitorEasyAdmin/_value_card.html.twig', {title: 'Operations per second', metric: 'redis.requests_per_second', rate: view.requestsPerSec}) }}
        </div>
        <div class="col-md-6 col-xl-4">
            {{ include('@JmonitorEasyAdmin/_gauge.html.twig', {gauge: view.hitRate}) }}
        </div>
        <div class="col-md-6 col-xl-4">
            {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Stats', metric: 'redis.stats'} %}
                {% block body %}
                    {{ include('@JmonitorEasyAdmin/_kv.html.twig', {rows: {
                        'Evicted keys': view.evictedKeys,
                        'Rejected connections': view.rejectedConnections,
                        'Total errors': view.totalErrors,
                        'Clients connected': view.clients,
                    }}) }}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {% if view.databases is not empty %}
        <h2 class="h5 mt-4 mb-2">Databases</h2>
        <div class="row g-3">
            {% for database in view.databases %}
                <div class="col-md-6 col-xxl-4">
                    {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: database.name} %}
                        {% block body %}
                            <div class="row g-3">
                                <div class="col-4">{{ include('@JmonitorEasyAdmin/_sub_value.html.twig', {label: 'Keys', metric: 'redis.db_keys', value: database.keys}) }}</div>
                                <div class="col-4">{{ include('@JmonitorEasyAdmin/_sub_value.html.twig', {label: 'Expiring keys', metric: 'redis.db_expiring_keys', value: database.expiring is null ? null : database.expiring ~ '%'}) }}</div>
                                <div class="col-4">{{ include('@JmonitorEasyAdmin/_sub_value.html.twig', {label: 'Average TTL', metric: 'redis.db_avg_ttl', value: database.avg_ttl is null ? null : database.avg_ttl|jm_duration}) }}</div>
                            </div>
                        {% endblock %}
                    {% endembed %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block memory_peak %}
    {% embed '@JmonitorEasyAdmin/_card.html.twig' with {title: 'Memory peak', metric: 'redis.memory_peak'} %}
        {% block body %}
            {% if view.memoryPeak %}
                {{ include('@JmonitorEasyAdmin/_peak.html.twig', {
                    peak: view.memoryPeak,
                    currentLabel: view.usedMemory|jm_bytes,
                    peakLabel: view.peakMemory|jm_bytes,
                    maxLabel: view.maxMemoryBytes|jm_bytes,
                }) }}
            {% else %}
                <div class="jm-stat">{{ view.peakMemory|jm_bytes }}</div>
                <div class="small text-muted">Current: {{ view.usedMemory|jm_bytes }}</div>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
