{
    "name": "jmonitor/easyadmin-bundle",
    "description": "Live monitoring pages inside EasyAdmin: system, PHP, FrankenPHP, Apache, MySQL, PostgreSQL, Redis and Symfony metrics collected when you open the page, no worker required.",
    "keywords": [
        "monitoring",
        "metrics",
        "easyadmin",
        "symfony",
        "mysql",
        "postgresql",
        "redis",
        "php",
        "frankenphp",
        "apache",
        "system",
        "opcache"
    ],
    "homepage": "https://jmonitor.io",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Plantey",
            "homepage": "https://jonathan-plantey.fr/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "easycorp/easyadmin-bundle": "^5.2",
        "jmonitor/collector": "^2.3.0",
        "psr/cache": "^1.0|^2.0|^3.0",
        "psr/container": "^1.1|^2.0",
        "psr/log": "^2.0|^3.0",
        "symfony/asset": "^6.4|^7.0|^8.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/clock": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/process": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/security-csrf": "^6.4|^7.0|^8.0",
        "symfony/service-contracts": "^2.5|^3.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "predis/predis": "^2.0|^3.0",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/css-selector": "^6.4|^7.0|^8.0",
        "symfony/ux-twig-component": "^2.20|^3.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "twig/extra-bundle": "^3.15"
    },
    "autoload": {
        "psr-4": {
            "Jmonitor\\EasyAdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmonitor\\EasyAdminBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "scripts": {
        "lint:check": "./vendor/bin/php-cs-fixer check --verbose --diff",
        "lint:fix": "./vendor/bin/php-cs-fixer fix --verbose --diff",
        "phpstan": "./vendor/bin/phpstan",
        "phpunit": "./vendor/bin/phpunit"
    }
}
