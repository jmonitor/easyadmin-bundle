parameters:
    level: 8
    paths:
        - src
    # Some ignores only match on certain Symfony versions. Don't fail when an ignore is unmatched.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # On Symfony 6.4, DefinitionConfigurator::rootNode() is typed as NodeDefinition
        # (no children()), while at runtime it always returns an ArrayNodeDefinition.
        -
            message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeDefinition::children\(\)\.$#'
            path: src/JmonitorEasyAdminBundle.php
        # The Messenger default depends on the installed Symfony version.
        -
            message: '#^(Comparison operation ">=" between \d+ and 70200 is always (true|false)|Result of && is always false)\.$#'
            path: src/JmonitorEasyAdminBundle.php
        # KernelInterface::getShareDir() only exists on recent Symfony versions.
        -
            message: '#^Call to function method_exists\(\) with Symfony\\Component\\HttpKernel\\KernelInterface and ''getShareDir'' will always evaluate to true\.$#'
            path: src/Collector/Symfony/SymfonyCollector.php
